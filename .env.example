# Stripe API Keys (get these from https://dashboard.stripe.com/test/apikeys)
# Browser-accessible Vite variable (must use VITE_ prefix)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only Netlify Functions variable (must NOT use VITE_ prefix)
STRIPE_SECRET_KEY=sk_test_...
# Stripe Webhook signing secret for /.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail SMTP credentials for admin order & custom-request notifications
# Uses a 16-character Google App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=weeblesclay@gmail.com
GMAIL_APP_PASSWORD=...
